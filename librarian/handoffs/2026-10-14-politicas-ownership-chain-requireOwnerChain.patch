diff --git a/lib/analysis/public-body.test.ts b/lib/analysis/public-body.test.ts
index 2037897..f0d1122 100644
--- a/lib/analysis/public-body.test.ts
+++ b/lib/analysis/public-body.test.ts
@@ -352,3 +352,45 @@ describe("ownershipRecord — the s.r.o. `spolecnik[]` shape (money batch 018)",
     expect(v.kind).toBe("private");
   });
 });
+
+describe("requireOwnerChain (ownership-chain-traversal)", () => {
+  const rail = {
+    ico: "27257258",
+    name: "Výzkumný Ústav Železniční, a.s.",
+    legalForm: "121",
+    vrRetrieved: true,
+    ownersRecorded: 1,
+  };
+  const parent = { ico: "70994226", name: "České dráhy, a.s.", legalForm: "121", current: true };
+
+  it("A: the one-hop answer files a state group's subsidiary as private", () => {
+    expect(classifyPublicMandate({ ...rail, shareholders: [parent] }).kind).toBe("private");
+  });
+
+  it("B: an unwalked private-form corporate owner is unknown, and stays attributable", () => {
+    const v = classifyPublicMandate({ ...rail, shareholders: [parent], requireOwnerChain: true });
+    expect(v.kind).toBe("unknown");
+    expect(v.attributable).toBe(true);
+  });
+
+  it("B: private is earned only when the walk above the owner ended non-public", () => {
+    const v = classifyPublicMandate({
+      ...rail,
+      shareholders: [{ ...parent, upstream: "private-terminal" }],
+      requireOwnerChain: true,
+    });
+    expect(v.kind).toBe("private");
+  });
+
+  it("B: a historical owner does not block, a public owner still wins, natural-person-only is untouched", () => {
+    expect(classifyPublicMandate({ ...rail, shareholders: [{ ...parent, current: false }], requireOwnerChain: true }).kind).toBe("private");
+    expect(
+      classifyPublicMandate({
+        ...rail,
+        shareholders: [{ ico: "44992785", name: "Statutární město Brno", legalForm: "801", current: true }, parent],
+        requireOwnerChain: true,
+      }).kind,
+    ).toBe("publicly-owned");
+    expect(classifyPublicMandate({ ...rail, shareholders: [], requireOwnerChain: true }).kind).toBe("private");
+  });
+});
diff --git a/lib/analysis/public-body.ts b/lib/analysis/public-body.ts
index 3a57e32..e32d974 100644
--- a/lib/analysis/public-body.ts
+++ b/lib/analysis/public-body.ts
@@ -124,6 +124,12 @@ export interface Shareholder {
   /** Share in percent when VR states it (s.r.o. `podil[].velikostPodilu`, PROCENTA or
    *  "50%"-style TEXT); null when VR does not — an a.s. akcionář carries none. */
   sharePct?: number | null;
+  /**
+   * What walking UP from this owner established. Absent = the owner's own owners were
+   * never read. `private-terminal` = the walk reached natural persons / a non-public
+   * end within its bounds. Only consulted when `requireOwnerChain` is set.
+   */
+  upstream?: "private-terminal";
 }
 
 export interface PublicMandateInput {
@@ -143,6 +149,15 @@ export interface PublicMandateInput {
    * than having its verdicts silently change underneath it.
    */
   ownersRecorded?: number;
+  /**
+   * Opt-in (ownership-chain-traversal): a legal-person owner with a private-law form is
+   * not evidence of private ownership until the walk above it ended somewhere non-public
+   * (`Shareholder.upstream === "private-terminal"`). A form-private a.s. can be the state
+   * group's own subsidiary (a state railway's research institute sat as `private` this
+   * way). When set, an unwalked corporate owner yields `unknown`, still attributable.
+   * Absent keeps the one-hop answer, so no caller's verdict moves silently.
+   */
+  requireOwnerChain?: boolean;
 }
 
 export type PublicMandateKind =
@@ -249,6 +264,19 @@ export function classifyPublicMandate(input: PublicMandateInput): PublicMandateV
     };
   }
 
+  if (input.requireOwnerChain) {
+    const unwalked = input.shareholders.filter((s) => s.current && s.upstream !== "private-terminal");
+    if (unwalked.length > 0) {
+      return {
+        kind: "unknown",
+        reason: `Právní forma ${input.legalForm} je soukromoprávní a současným společníkem/akcionářem je právnická osoba (${unwalked.map((o) => o.name).join(", ")}), jejíž vlastníci nebyli dohledáni — soukromá právní forma vlastníka není důkazem soukromého vlastnictví. Řetězec nebyl prověřen, ne vyvrácen; vyžaduje ruční posouzení.`,
+        publicOwners: [],
+        unknownCodes: [...new Set(unknownCodes)],
+        attributable: true,
+      };
+    }
+  }
+
   // The distinction this module was missing: "VR names owners, none of them public" is
   // evidence of private ownership; "VR names no current owner at all" is no evidence of
   // anything. `ownersRecorded` is undefined for callers that have not been updated —
