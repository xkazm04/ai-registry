diff --git a/browse/test/error-rewrite.test.ts b/browse/test/error-rewrite.test.ts
new file mode 100644
index 0000000..cb657d0
--- /dev/null
+++ b/browse/test/error-rewrite.test.ts
@@ -0,0 +1,48 @@
+import { describe, test, expect } from 'bun:test';
+import * as fs from 'fs';
+import * as path from 'path';
+import { wrapError } from '../src/error-rewrite';
+
+// Errors recorded from a real Chromium run on playwright 1.62.1, not hand-written:
+// the rewrite table is a bet on the driver's wording, so the pin has to be the wording.
+const recorded: Record<string, { name: string; message: string }> = JSON.parse(
+  fs.readFileSync(path.join(__dirname, 'fixtures', 'playwright-1.62.1-errors.json'), 'utf8'),
+);
+const wrap = (k: string) => wrapError(Object.assign(new Error(recorded[k].message), { name: recorded[k].name }));
+
+// An agent-actionable message carries no driver internals (call log, ANSI) and, where the
+// recovery is a command, names it.
+const noInternals = (m: string) => !m.includes('Call log') && !m.includes('\u001b');
+const ELEMENT_TIMEOUTS = ['click_missing', 'fill_missing', 'check_missing', 'press_missing',
+  'type_missing', 'select_missing', 'wait_selector'];
+const STRICT = ['strict_click', 'strict_text', 'strict_fill'];
+const NAVIGATION = ['goto_refused', 'goto_timeout', 'goto_dns'];
+
+describe('wrapError against recorded driver errors', () => {
+  test('the pre-existing rewrites keep their text', () => {
+    expect(wrap('click_missing')).toContain("run 'snapshot'");
+    expect(wrap('fill_missing')).toContain("run 'snapshot'");
+    expect(wrap('goto_timeout')).toBe('Page navigation timed out. The URL may be unreachable or the page may be loading slowly.');
+    for (const k of STRICT) expect(wrap(k)).toContain("use @refs from 'snapshot'");
+  });
+
+  test('every element-wait timeout names snapshot and hides the call log', () => {
+    for (const k of ELEMENT_TIMEOUTS) {
+      const m = wrap(k);
+      expect(m, k).toContain("'snapshot'");
+      expect(noInternals(m), k).toBe(true);
+    }
+  });
+
+  test('a navigation failure that is not a timeout keeps the net error and drops the call log', () => {
+    for (const k of NAVIGATION) expect(noInternals(wrap(k)), k).toBe(true);
+    expect(wrap('goto_refused')).toContain('ERR_UNSAFE_PORT');
+  });
+
+  test("the tool's own errors pass through untouched, multi-line included", () => {
+    const usage = 'Usage: goto <url>\n  e.g. goto https://example.com';
+    expect(wrapError(new Error('Unknown ref @e9'))).toBe('Unknown ref @e9');
+    expect(wrapError(new Error(usage))).toBe(usage);
+    expect(wrapError('plain string')).toBe('plain string');
+  });
+});
