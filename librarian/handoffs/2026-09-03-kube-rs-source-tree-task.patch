+/// A finalizer path could not be parsed as a JSON pointer; surfaced as [`Error::InvalidFinalizer`].
+#[derive(Debug)]
+struct InvalidFinalizerPath;
+
+/// Build the patch that removes our finalizer at `finalizer_index`.
+///
+/// The removal is preconditioned on both the position (the index still holds our name) and, when
+/// the object has one, its `uid`. The index alone does not identify an object: if the object is
+/// deleted, recreated under the same name and finalized again between the `Cleanup` call and this
+/// patch, our name sits at the same index on a *different* object, and removing it would release a
+/// hold whose cleanup never ran. Testing the uid pins the removal to the object cleanup ran for.
+fn remove_finalizer_patch(
+    finalizer_name: &str,
+    finalizer_index: usize,
+    uid: Option<&str>,
+) -> Result<json_patch::Patch, InvalidFinalizerPath> {
+    let finalizer_path = format!("/metadata/finalizers/{finalizer_index}");
+    let mut ops = Vec::with_capacity(3);
+    if let Some(uid) = uid {
+        ops.push(PatchOperation::Test(TestOperation {
+            path: PointerBuf::from_str("/metadata/uid").map_err(|_err| InvalidFinalizerPath)?,
+            value: uid.into(),
+        }));
+    }
+    // All finalizers run concurrently and we use an integer index
+    // `Test` ensures that we fail instead of deleting someone else's finalizer
+    // (in which case a new `Cleanup` event will be sent)
+    ops.push(PatchOperation::Test(TestOperation {
+        path: PointerBuf::from_str(finalizer_path.as_str()).map_err(|_err| InvalidFinalizerPath)?,
+        value: finalizer_name.into(),
+    }));
+    ops.push(PatchOperation::Remove(RemoveOperation {
+        path: PointerBuf::from_str(finalizer_path.as_str()).map_err(|_err| InvalidFinalizerPath)?,
+    }));
+    Ok(json_patch::Patch(ops))
+}
+
+/// Build the patch that adds our finalizer to an object whose current list is `finalizers`.
+fn add_finalizer_patch(
+    finalizer_name: &str,
+    finalizers: &[String],
+) -> Result<json_patch::Patch, InvalidFinalizerPath> {
+    Ok(json_patch::Patch(if finalizers.is_empty() {
+        vec![
+            PatchOperation::Test(TestOperation {
+                path: PointerBuf::from_str("/metadata/finalizers").map_err(|_err| InvalidFinalizerPath)?,
+                value: serde_json::Value::Null,
+            }),
+            PatchOperation::Add(AddOperation {
+                path: PointerBuf::from_str("/metadata/finalizers").map_err(|_err| InvalidFinalizerPath)?,
+                value: vec![finalizer_name].into(),
+            }),
+        ]
+    } else {
+        vec![
+            // Kubernetes doesn't automatically deduplicate finalizers (see
+            // https://github.com/kube-rs/kube/issues/964#issuecomment-1197311254),
+            // so we need to fail and retry if anyone else has added the finalizer in the meantime
+            PatchOperation::Test(TestOperation {
+                path: PointerBuf::from_str("/metadata/finalizers").map_err(|_err| InvalidFinalizerPath)?,
+                value: finalizers.into(),
+            }),
+            PatchOperation::Add(AddOperation {
+                path: PointerBuf::from_str("/metadata/finalizers/-").map_err(|_err| InvalidFinalizerPath)?,
+                value: finalizer_name.into(),
+            }),
+        ]
+    }))
+}
+
 /// A representation of an action that should be taken by a reconciler.
 pub enum Event<K> {
     /// The reconciler should ensure that the actual state matches the state desired in the object.
@@ -252,3 +286,65 @@ pub enum Event<K> {
     /// - The grinch's heart grows a size or two
     Cleanup(Arc<K>),
 }
+
+#[cfg(test)]
+mod tests {
+    use super::{add_finalizer_patch, remove_finalizer_patch};
+    use serde_json::json;
+
+    const FINALIZER: &str = "example.com/cleanup";
+
+    fn as_json(patch: &json_patch::Patch) -> serde_json::Value {
+        serde_json::to_value(patch).unwrap()
+    }
+
+    #[test]
+    fn remove_patch_is_preconditioned_on_the_uid_and_the_index() {
+        let patch = remove_finalizer_patch(FINALIZER, 1, Some("uid-1")).unwrap();
+        assert_eq!(
+            as_json(&patch),
+            json!([
+                {"op": "test", "path": "/metadata/uid", "value": "uid-1"},
+                {"op": "test", "path": "/metadata/finalizers/1", "value": FINALIZER},
+                {"op": "remove", "path": "/metadata/finalizers/1"},
+            ])
+        );
+    }
+
+    #[test]
+    fn remove_patch_omits_the_uid_test_when_the_object_has_no_uid() {
+        let patch = remove_finalizer_patch(FINALIZER, 0, None).unwrap();
+        assert_eq!(
+            as_json(&patch),
+            json!([
+                {"op": "test", "path": "/metadata/finalizers/0", "value": FINALIZER},
+                {"op": "remove", "path": "/metadata/finalizers/0"},
+            ])
+        );
+    }
+
+    #[test]
+    fn add_patch_creates_the_list_when_it_is_absent() {
+        let patch = add_finalizer_patch(FINALIZER, &[]).unwrap();
+        assert_eq!(
+            as_json(&patch),
+            json!([
+                {"op": "test", "path": "/metadata/finalizers", "value": null},
+                {"op": "add", "path": "/metadata/finalizers", "value": [FINALIZER]},
+            ])
+        );
+    }
+
+    #[test]
+    fn add_patch_tests_the_whole_list_before_appending() {
+        let existing = ["other.example.com/cleanup".to_string()];
+        let patch = add_finalizer_patch(FINALIZER, &existing).unwrap();
+        assert_eq!(
+            as_json(&patch),
+            json!([
+                {"op": "test", "path": "/metadata/finalizers", "value": ["other.example.com/cleanup"]},
+                {"op": "add", "path": "/metadata/finalizers/-", "value": FINALIZER},
+            ])
+        );
+    }
+}
