 "laws": {
  "measure-the-tree-not-the-summary": {
   "statement": "What a run claims in its final message is evidence about the run's honesty, never evidence about the repository. Every fact a verdict rests on is recomputed from the tree itself — the commits, the gates, the files left behind, the rules the repository declares. A harness that reads the summary is grading prose.",
   "techniques": [
    "agent-benchmark-design/comparable-cell-construction",
    "agent-benchmark-design/eligibility-before-ranking",
    "agent-run-budgeting/refusal-detection-and-requeue",
    "blind-judging-of-agent-runs/facts-beside-the-work",
    "deterministic-run-verification/baseline-relative-gate-evaluation",
    "deterministic-run-verification/declared-rule-verification",
    "deterministic-run-verification/recompute-facts-at-report-time",
    "engine-behaviour-profiles/authority-conflict-disposition",
    "engine-behaviour-profiles/capability-claims-expire",
    "engine-behaviour-profiles/family-diversity-as-a-control",
    "harness-fault-attribution/clear-the-environment-first",
    "harness-fault-attribution/retract-and-record",
    "model-and-effort-selection/cheapest-sufficient-tier",
    "model-and-effort-selection/instruction-defect-before-tier-escalation",
    "model-and-effort-selection/tier-risk-inversion",
    "unattended-run-isolation/no-links-into-live-trees"
   ]
  },
  "the-harness-is-a-suspect-in-every-red": {
   "statement": "Before a failure is attributed to a model, the environment it ran in is cleared: shared build caches, links into real trees, a suspended host clock, a stale artifact from a sibling run. Attribution without that step produces confident findings about models that are actually findings about the bench, and they are the hardest kind to retract because they look like data.",
   "techniques": [
    "agent-benchmark-design/comparable-cell-construction",
    "deterministic-run-verification/baseline-relative-gate-evaluation",
    "harness-fault-attribution/clear-the-environment-first",
    "harness-fault-attribution/fault-signature-catalogue",
    "harness-fault-attribution/retract-and-record",
    "unattended-run-isolation/confine-configured-output-paths",
    "unattended-run-isolation/disposable-run-environments",
    "unattended-run-isolation/no-links-into-live-trees"
   ]
  },
  "a-refusal-is-not-a-result": {
   "statement": "A run that never happened — a seat that refused it, a provider at capacity, a host that suspended it until its own ceiling killed it — is requeued, never scored. The moment such an outcome is allowed into the results it becomes a measurement of the vendor's queue wearing a model's name, and every aggregate over it is wrong in the direction nobody checks. Detection must read whatever the runner actually returns: the refusal may arrive labelled as a success, with the reason only in the text.",
   "techniques": [
    "agent-benchmark-design/coverage-and-provisional-labelling",
    "agent-run-budgeting/allowance-budgeting-across-workloads",
    "agent-run-budgeting/refusal-detection-and-requeue",
    "blind-judging-of-agent-runs/withhold-rather-than-half-judge"
   ]
  },
  "a-ceiling-is-a-measurement-boundary": {
   "statement": "Every ceiling a fleet enforces — wall-clock, tokens, attempts — is part of the measurement, not an operational detail. A run that hit one is reported as having hit it, never as a finished run that scored badly, and a clock that kept counting while the host slept measures nothing at all.",
   "techniques": [
    "agent-benchmark-design/coverage-and-provisional-labelling",
    "agent-run-budgeting/ceiling-as-measurement-boundary",
    "harness-fault-attribution/fault-signature-catalogue",
    "model-and-effort-selection/task-shape-tier-policy"
   ]
  },
  "the-repository-outranks-the-instruction": {
   "statement": "Where a task's instruction and the repository's own declared rules disagree, the repository wins and the run says so. A repository that excludes a path from version control has decided that path is private; an instruction to commit that kind of artifact does not overturn the decision, and a run that forces it commits someone's private material into a published tree.",
   "techniques": [
    "agent-benchmark-design/eligibility-before-ranking",
    "blind-judging-of-agent-runs/facts-beside-the-work",
    "deterministic-run-verification/declared-rule-verification",
    "engine-behaviour-profiles/authority-conflict-disposition",
    "model-and-effort-selection/tier-risk-inversion",
    "unattended-run-isolation/confine-configured-output-paths"
   ]
  },
  "the-judge-never-grades-its-own-family": {
   "statement": "A verdict on a run is produced by at least one judge from a different vendor family than the agent, because self-preference is a constant, not noise, and a constant survives averaging. When only one family is available the verdicts are still worth having and are labelled single-family and provisional, never quietly merged with cross-family ones.",
   "techniques": [
    "agent-run-budgeting/allowance-budgeting-across-workloads",
    "blind-judging-of-agent-runs/provenance-scrubbing",
    "blind-judging-of-agent-runs/withhold-rather-than-half-judge",
    "engine-behaviour-profiles/family-diversity-as-a-control"
   ]
  }
 }
